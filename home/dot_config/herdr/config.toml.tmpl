{{- $fish := "/usr/bin/fish" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $fish = "/opt/homebrew/bin/fish" -}}
{{- if eq .chezmoi.arch "amd64" -}}
{{- $fish = "/usr/local/bin/fish" -}}
{{- end -}}
{{- end -}}
# Herdr 0.8.2+. Keep runtime state, sockets and logs out of dotfiles.
onboarding = false

[theme]
name = "gruvbox"
auto_switch = false

[theme.custom]
# Gruvbox defaults to #282828 here, hiding separators against Ghostty.
# Match the scrollbar track / muted thumb (overlay0).
surface_dim = "#928374"
# Active tabs and focused borders share this token; soften the yellow fill.
accent = "#b39a62"

[terminal]
default_shell = {{ $fish | quote }}
shell_mode = "auto"
new_cwd = "follow"

[keys]
prefix = "`"
reload_config = "prefix+r"
resize_mode = "prefix+shift+r"
detach = "prefix+q"
focus_pane_left = ["prefix+h", "prefix+left"]
focus_pane_down = ["prefix+j", "prefix+down"]
focus_pane_up = ["prefix+k", "prefix+up"]
focus_pane_right = ["prefix+l", "prefix+right"]
resize_pane_left = "prefix+shift+h"
resize_pane_down = "prefix+shift+j"
resize_pane_up = "prefix+shift+k"
resize_pane_right = "prefix+shift+l"
split_vertical = "prefix+|"
split_horizontal = ["prefix+minus", 'prefix+\']
zoom = "prefix+f"
new_tab = "prefix+c"
previous_tab = "ctrl+shift+tab"
next_tab = ["prefix+n", "ctrl+tab"]
switch_tab = "prefix+1..9"
# Native equivalents of kitmux's workspace picker and palette navigation.
workspace_picker = ["prefix+o", "prefix+w", "alt+s"]
goto = ["prefix+e", "alt+k"]
open_worktree = "prefix+shift+w"
rename_workspace = "prefix+alt+w"
open_notification_target = "prefix+shift+a"
focus_agent = "prefix+alt+1..9"

[[keys.command]]
key = "prefix+p"
type = "popup"
command = "exec {{ $fish }} --login --interactive"
description = "Fish scratch terminal"
width = "80%"
height = "80%"

[[keys.command]]
key = "alt+j"
type = "popup"
command = "exec {{ $fish }} --login --interactive"
description = "Fish scratch terminal"
width = "80%"
height = "80%"

[[keys.command]]
key = "prefix+g"
type = "popup"
command = "lazygit"
description = "Lazygit"
width = "100%"
height = "100%"

[[keys.command]]
key = "prefix+v"
type = "popup"
command = "nvim"
description = "Neovim"
width = "100%"
height = "100%"

[[keys.command]]
key = "prefix+z"
type = "shell"
command = "zed ."
description = "Open current directory in Zed"

[ui]
agent_panel_sort = "priority"
pane_borders = true
pane_outer_borders = false
pane_gaps = false
pane_scrollbars = true
prompt_new_tab_name = false
